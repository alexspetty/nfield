import NField.Alignment.SynchronizedPeriodAlignment

/-!
# Multiplicative remainder orbits

This module formalizes the cyclic families produced by multiplication by a
positional base modulo a coprime prime.  The family index is the quotient of
the unit group by the cyclic subgroup generated by the base.  A supported
denominator contributes `m` numerator representatives for every unit residue,
so the lifted families have size `m * L`.
-/

namespace NField.Alignment

/-- The base regarded as a unit modulo a coprime prime. -/
noncomputable def primeBaseUnit (b p : ℕ) (hp : p.Prime) (hpb : ¬p ∣ b) :
    (ZMod p)ˣ :=
  ZMod.unitOfCoprime b (hp.coprime_iff_not_dvd.mpr hpb).symm

/-- The cyclic subgroup generated by the base modulo the prime. -/
noncomputable def primeBaseOrbitSubgroup
    (b p : ℕ) (hp : p.Prime) (hpb : ¬p ∣ b) : Subgroup (ZMod p)ˣ :=
  Subgroup.zpowers (primeBaseUnit b p hp hpb)

/-- One multiplicative remainder family, indexed by a coset of the base
subgroup. -/
def PrimeBaseOrbitFamily {b p : ℕ} (hp : p.Prime) (hpb : ¬p ∣ b)
    (C : (ZMod p)ˣ ⧸ primeBaseOrbitSubgroup b p hp hpb) :=
  {x : (ZMod p)ˣ //
    (x : (ZMod p)ˣ ⧸ primeBaseOrbitSubgroup b p hp hpb) = C}

/-- The lifted family records the `m` numerator representatives carried by
each nonzero residue. -/
def LiftedPrimeBaseOrbitFamily {b p : ℕ} (hp : p.Prime) (hpb : ¬p ∣ b)
    (m : ℕ) (C : (ZMod p)ˣ ⧸ primeBaseOrbitSubgroup b p hp hpb) :=
  PrimeBaseOrbitFamily hp hpb C × Fin m

/-- The cyclic subgroup has cardinality equal to the multiplicative period. -/
theorem primeBaseOrbitSubgroup_card {b p : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b) :
    Nat.card (primeBaseOrbitSubgroup b p hp hpb) =
      primeBasePeriod b p hp hpb := by
  unfold primeBaseOrbitSubgroup primeBasePeriod primeBaseUnit
  exact Nat.card_zpowers _

/-- The number of cyclic remainder families is `(p-1)/L`. -/
theorem primeBaseOrbitFamily_count {b p : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b) :
    Nat.card ((ZMod p)ˣ ⧸ primeBaseOrbitSubgroup b p hp hpb) =
      (p - 1) / primeBasePeriod b p hp hpb := by
  letI : NeZero p := ⟨hp.ne_zero⟩
  letI : Fact p.Prime := ⟨hp⟩
  let H := primeBaseOrbitSubgroup b p hp hpb
  let L := primeBasePeriod b p hp hpb
  have hcard := Subgroup.card_eq_card_quotient_mul_card_subgroup H
  have hL : 0 < L := primeBasePeriod_pos hp hpb
  have hunits : Nat.card (ZMod p)ˣ = p - 1 := by
    rw [Nat.card_eq_fintype_card, ZMod.card_units]
  have hH : Nat.card H = L := by
    exact primeBaseOrbitSubgroup_card hp hpb
  rw [hunits, hH] at hcard
  exact (Nat.div_eq_of_eq_mul_left hL hcard).symm

/-- Every quotient fiber is one coset and therefore contains exactly `L`
unit residues. -/
theorem primeBaseOrbitFamily_card {b p : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b)
    (C : (ZMod p)ˣ ⧸ primeBaseOrbitSubgroup b p hp hpb) :
    Nat.card (PrimeBaseOrbitFamily hp hpb C) =
      primeBasePeriod b p hp hpb := by
  let H := primeBaseOrbitSubgroup b p hp hpb
  have hcard := QuotientGroup.card_preimage_mk H ({C} : Set ((ZMod p)ˣ ⧸ H))
  have hfamily : Nat.card (PrimeBaseOrbitFamily hp hpb C) =
      Nat.card (QuotientGroup.mk ⁻¹' ({C} : Set ((ZMod p)ˣ ⧸ H))) := by
    apply Nat.card_congr
    refine
      { toFun := fun x => ⟨x.1, by
          change QuotientGroup.mk x.1 ∈ ({C} : Set ((ZMod p)ˣ ⧸ H))
          simpa only [Set.mem_singleton_iff] using x.2⟩
        invFun := fun x => ⟨x.1, by
          have hx : QuotientGroup.mk x.1 = C := by
            simpa only [Set.mem_preimage, Set.mem_singleton_iff] using x.2
          exact hx⟩
        left_inv := by intro x; rfl
        right_inv := by intro x; rfl }
  rw [hfamily, hcard]
  have hH : Nat.card H = primeBasePeriod b p hp hpb :=
    primeBaseOrbitSubgroup_card hp hpb
  rw [hH]
  simp

/-- After lifting every residue by its `m` numerator representatives, each
family contains exactly `m*L` fractions. -/
theorem liftedPrimeBaseOrbitFamily_card {b p m : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b)
    (C : (ZMod p)ˣ ⧸ primeBaseOrbitSubgroup b p hp hpb) :
    Nat.card (LiftedPrimeBaseOrbitFamily hp hpb m C) =
      m * primeBasePeriod b p hp hpb := by
  rw [LiftedPrimeBaseOrbitFamily, Nat.card_prod,
    primeBaseOrbitFamily_card hp hpb, Nat.card_fin]
  exact Nat.mul_comm _ _

/-- Two nonzero residues lie in the same family exactly when one is obtained
from the other by a power of the base in the canonical range `0 <= j < L`. -/
theorem same_primeBaseOrbit_iff {b p : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b) (x y : (ZMod p)ˣ) :
    (x : (ZMod p)ˣ ⧸ primeBaseOrbitSubgroup b p hp hpb) = y ↔
      ∃ j < primeBasePeriod b p hp hpb,
        x * (primeBaseUnit b p hp hpb) ^ j = y := by
  let u := primeBaseUnit b p hp hpb
  let H := primeBaseOrbitSubgroup b p hp hpb
  let L := primeBasePeriod b p hp hpb
  have horder : orderOf u = L := by
    simp [u, L, primeBaseUnit, primeBasePeriod]
  have horder' : orderOf u = primeBasePeriod b p hp hpb := by
    simpa [L] using horder
  rw [show (x : (ZMod p)ˣ ⧸ H) = y ↔
      ∃ z ∈ H, x * z = y by
    exact QuotientGroup.mk'_eq_mk' H]
  constructor
  · rintro ⟨z, hz, hxz⟩
    have hz' : z ∈ (Finset.range (orderOf u)).image (u ^ ·) :=
      (mem_zpowers_iff_mem_range_orderOf).mp (by
        simpa [H, primeBaseOrbitSubgroup, u] using hz)
    rcases Finset.mem_image.mp hz' with ⟨j, hj, rfl⟩
    exact ⟨j, by simpa only [← horder'] using Finset.mem_range.mp hj,
      by simpa [u] using hxz⟩
  · rintro ⟨j, hj, hxj⟩
    refine ⟨u ^ j, ?_, ?_⟩
    · apply (mem_zpowers_iff_mem_range_orderOf).mpr
      apply Finset.mem_image.mpr
      refine ⟨j, ?_, rfl⟩
      apply Finset.mem_range.mpr
      rw [horder']
      exact hj
    · simpa [u] using hxj

/-- A residue returns after `q` long-division steps exactly when the base
period divides `q`. -/
theorem primeBaseOrbit_return_iff {b p q : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b) (x : (ZMod p)ˣ) :
    (primeBaseUnit b p hp hpb) ^ q * x = x ↔
      primeBasePeriod b p hp hpb ∣ q := by
  let u := primeBaseUnit b p hp hpb
  constructor
  · intro hreturn
    have hu : u ^ q = 1 := by
      apply mul_right_cancel (b := x)
      simpa [u] using hreturn
    simpa [u, primeBaseUnit, primeBasePeriod] using
      (orderOf_dvd_iff_pow_eq_one.mpr hu)
  · intro hdiv
    have hu : u ^ q = 1 :=
      orderOf_dvd_iff_pow_eq_one.mp (by
        simpa [u, primeBaseUnit, primeBasePeriod] using hdiv)
    simp [u, hu]

/-- The first positive return time of every nonzero remainder state is the
same multiplicative period `L`. -/
theorem primeBasePeriod_is_least_return {b p q : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b) (x : (ZMod p)ˣ)
    (hq : 0 < q) (hreturn : (primeBaseUnit b p hp hpb) ^ q * x = x) :
    primeBasePeriod b p hp hpb ≤ q := by
  exact Nat.le_of_dvd hq ((primeBaseOrbit_return_iff hp hpb x).mp hreturn)

/-- The digit emitted by a unit remainder after `j` multiplications by the
base. -/
noncomputable def primeOrbitDigit {b p : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b) (x : (ZMod p)ˣ) (j : ℕ) : ℕ :=
  by
    letI : NeZero p := ⟨hp.ne_zero⟩
    exact NField.CollisionDefinition.digitBin b p
      (((((primeBaseUnit b p hp hpb) ^ j * x : (ZMod p)ˣ) : ZMod p)).val)

/-- Multiplying a starting residue by `b^s` cyclically shifts its emitted
digit word by `s` positions. -/
theorem primeOrbitDigit_mul_base_pow {b p : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b) (x : (ZMod p)ˣ) (j s : ℕ) :
    primeOrbitDigit hp hpb (x * (primeBaseUnit b p hp hpb) ^ s) j =
      primeOrbitDigit hp hpb x (j + s) := by
  letI : NeZero p := ⟨hp.ne_zero⟩
  have hunit :
      (primeBaseUnit b p hp hpb) ^ j *
          (x * (primeBaseUnit b p hp hpb) ^ s) =
        (primeBaseUnit b p hp hpb) ^ (j + s) * x := by
    rw [pow_add]
    ac_rfl
  exact congrArg
    (fun z : (ZMod p)ˣ =>
      NField.CollisionDefinition.digitBin b p ((z : ZMod p).val)) hunit

/-- Distinct quotient families cannot be cyclic shifts of one another. -/
theorem different_primeBaseOrbits_not_power_shift {b p : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b) (x y : (ZMod p)ˣ)
    (hfamily : (x : (ZMod p)ˣ ⧸ primeBaseOrbitSubgroup b p hp hpb) ≠ y) :
    ¬∃ j : ℕ, x * (primeBaseUnit b p hp hpb) ^ j = y := by
  rintro ⟨j, hj⟩
  have hmem : (primeBaseUnit b p hp hpb) ^ j ∈
      primeBaseOrbitSubgroup b p hp hpb := by
    apply Subgroup.mem_zpowers_iff.mpr
    exact ⟨(j : ℤ), by simp⟩
  apply hfamily
  exact (QuotientGroup.mk'_eq_mk' (primeBaseOrbitSubgroup b p hp hpb)).2
    ⟨(primeBaseUnit b p hp hpb) ^ j, hmem, hj⟩

/-- The number of nonterminating positive numerators below `p*m`. -/
def nonterminatingNumeratorCount (p m : ℕ) : ℕ :=
  p * m - 1 - terminatingNumeratorCount p m

/-- Exactly `(p-1)m` fractions retain the rough prime denominator. -/
theorem nonterminatingNumeratorCount_eq {p m : ℕ}
    (hp : 1 < p) (hm : 1 ≤ m) :
    nonterminatingNumeratorCount p m = (p - 1) * m := by
  rw [nonterminatingNumeratorCount, terminatingNumeratorCount_eq (by omega)]
  calc
    p * m - 1 - (m - 1) = p * m - m := by omega
    _ = (p - 1) * m := by
      symm
      rw [Nat.sub_mul, one_mul]

/-- The complete cycle-partition statement used by synchronized alignment. -/
def PrimeRemainderCyclePartitionStatement {b p : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b) (m : ℕ) : Prop :=
    Nat.card ((ZMod p)ˣ ⧸ primeBaseOrbitSubgroup b p hp hpb) =
        (p - 1) / primeBasePeriod b p hp hpb ∧
      (∀ C : (ZMod p)ˣ ⧸ primeBaseOrbitSubgroup b p hp hpb,
        Nat.card (LiftedPrimeBaseOrbitFamily hp hpb m C) =
          m * primeBasePeriod b p hp hpb) ∧
      nonterminatingNumeratorCount p m = (p - 1) * m ∧
      (∀ r < p, residueCount p r m = m) ∧
      (∀ x : (ZMod p)ˣ,
        (primeBaseUnit b p hp hpb) ^ primeBasePeriod b p hp hpb * x = x ∧
        ∀ q, 0 < q →
          (primeBaseUnit b p hp hpb) ^ q * x = x →
          primeBasePeriod b p hp hpb ≤ q)

/-- There are `(p-1)/L` families, each contains `mL` numerator
representatives, every unit remainder has least positive return `L`, and each
residue occurs `m` times below `p*m`. -/
theorem primeRemainderCyclePartition {b p m : ℕ}
    (hp : p.Prime) (hpb : ¬p ∣ b) (hm : 1 ≤ m) :
    PrimeRemainderCyclePartitionStatement hp hpb m := by
  unfold PrimeRemainderCyclePartitionStatement
  refine ⟨primeBaseOrbitFamily_count hp hpb,
    fun C => liftedPrimeBaseOrbitFamily_card hp hpb C,
    nonterminatingNumeratorCount_eq hp.one_lt hm,
    fun r hr => residueCount_eq hr, ?_⟩
  intro x
  constructor
  · exact (primeBaseOrbit_return_iff hp hpb x).2 dvd_rfl
  · intro q hq hreturn
    exact primeBasePeriod_is_least_return hp hpb x hq hreturn

end NField.Alignment
