import Mathlib.Analysis.Fourier.ZMod
import Mathlib.LinearAlgebra.Matrix.Circulant
import NField.Alignment.CrossAlignmentMatrix
import NField.Alignment.MultiplicativeRemainderOrbits

/-!
# Simultaneous Fourier reduction of cyclic block matrices

This file proves the general finite-dimensional mechanism behind a matrix of
circulant orbit blocks.  It includes an explicit complete Fourier synthesis,
so the frequency reduction is a genuine direct-sum decomposition rather than
only an entrywise block calculation.
-/

namespace NField.Alignment.CosetFourierReduction

open scoped BigOperators
open ZMod

variable {L : ℕ} [NeZero L]

/-- The negative-sign Fourier character used in the manuscript. -/
noncomputable def fourierBasisVector (j : ZMod L) : ZMod L → ℂ :=
  fun r => stdAddChar (-(r * j))

/-- A circulant acts diagonally on every Fourier character.  With the
negative-sign convention, the eigenvalue is the transform at `-j`. -/
theorem circulant_mulVec_fourierBasis (a : ZMod L → ℂ) (j : ZMod L) :
    Matrix.mulVec (Matrix.circulant a) (fourierBasisVector j) =
      (ZMod.dft a (-j)) • fourierBasisVector j := by
  funext r
  simp only [Matrix.mulVec, dotProduct, Matrix.circulant_apply,
    fourierBasisVector, Pi.smul_apply, smul_eq_mul, ZMod.dft_apply]
  calc
    ∑ s : ZMod L, a (r - s) * stdAddChar (-(s * j)) =
        ∑ u : ZMod L, a u * stdAddChar (-((r - u) * j)) := by
      apply Fintype.sum_equiv (Equiv.subLeft r)
      intro s
      simp
    _ = ∑ u : ZMod L,
        a u * (stdAddChar (-(r * j)) * stdAddChar (u * j)) := by
      apply Finset.sum_congr rfl
      intro u _
      rw [← AddChar.map_add_eq_mul]
      congr 2
      ring
    _ = (∑ u : ZMod L, stdAddChar (-(u * -j)) * a u) *
        stdAddChar (-(r * j)) := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro u _
      simp only [mul_neg, neg_neg]
      ring

/-- Synthesis from all Fourier character coordinates. -/
noncomputable def fourierSynthesis :
    (ZMod L → ℂ) →ₗ[ℂ] (ZMod L → ℂ) where
  toFun c r := ∑ j : ZMod L, c j * fourierBasisVector j r
  map_add' x y := by
    funext r
    simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
  map_smul' a x := by
    funext r
    simp only [Pi.smul_apply, RingHom.id_apply, smul_eq_mul]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    ring

/-- Fourier synthesis is exactly the ordinary discrete transform. -/
theorem fourierSynthesis_eq_dft (c : ZMod L → ℂ) :
    fourierSynthesis c = ZMod.dft c := by
  funext r
  simp only [fourierSynthesis, fourierBasisVector, smul_eq_mul, ZMod.dft_apply]
  apply Finset.sum_congr rfl
  intro j _
  simp [mul_comm]

/-- The character family is a complete basis, expressed as bijectivity of its
synthesis map. -/
theorem fourierSynthesis_bijective :
    Function.Bijective (fourierSynthesis (L := L)) := by
  constructor
  · intro x y h
    apply ZMod.dft.injective
    rw [← fourierSynthesis_eq_dft, ← fourierSynthesis_eq_dft]
    exact h
  · intro v
    obtain ⟨c, hc⟩ := ZMod.dft.surjective v
    refine ⟨c, ?_⟩
    rw [fourierSynthesis_eq_dft, hc]

section Blocks

variable {a : Type*} [Fintype a]

/-- A matrix whose `(i,j)` block is the circulant generated by
`kernel i j`. -/
def blockCirculantMatrix (kernel : a → a → ZMod L → ℂ) :
    Matrix (a × ZMod L) (a × ZMod L) ℂ :=
  fun i j => kernel i.1 j.1 (i.2 - j.2)

/-- The small matrix acting at Fourier frequency `j`. -/
noncomputable def blockFourierSymbol
    (kernel : a → a → ZMod L → ℂ) (j : ZMod L) : Matrix a a ℂ :=
  fun i k => ZMod.dft (kernel i k) (-j)

/-- Embed one small frequency vector into the full orbit-coordinate space. -/
noncomputable def frequencyEmbed (j : ZMod L) (z : a → ℂ) :
    a × ZMod L → ℂ :=
  fun i => z i.1 * fourierBasisVector j i.2

/-- Every frequency subspace is invariant and the induced action is exactly
the corresponding small symbol matrix. -/
theorem blockCirculantMatrix_mulVec_frequencyEmbed
    (kernel : a → a → ZMod L → ℂ)
    (j : ZMod L) (z : a → ℂ) :
    Matrix.mulVec (blockCirculantMatrix kernel) (frequencyEmbed j z) =
      frequencyEmbed j
        (Matrix.mulVec (blockFourierSymbol kernel j) z) := by
  funext i
  rcases i with ⟨i, r⟩
  simp only [Matrix.mulVec, dotProduct, blockCirculantMatrix,
    frequencyEmbed, blockFourierSymbol]
  rw [Fintype.sum_prod_type]
  have hblock (k : a) :
      (∑ s : ZMod L,
        kernel i k (r - s) *
          (z k * fourierBasisVector j s)) =
        (ZMod.dft (kernel i k) (-j) * z k) *
          fourierBasisVector j r := by
    have h := congrFun (circulant_mulVec_fourierBasis (kernel i k) j) r
    simp only [Matrix.mulVec, dotProduct, Matrix.circulant_apply,
      Pi.smul_apply, smul_eq_mul] at h
    calc
      ∑ s : ZMod L,
          kernel i k (r - s) * (z k * fourierBasisVector j s) =
          z k * ∑ s : ZMod L,
            kernel i k (r - s) * fourierBasisVector j s := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro s _
        ring
      _ = z k * (ZMod.dft (kernel i k) (-j) *
          fourierBasisVector j r) := by rw [h]
      _ = (ZMod.dft (kernel i k) (-j) * z k) *
          fourierBasisVector j r := by ring
  simp_rw [hblock]
  rw [Finset.sum_mul]

/-- Full synthesis over both the family and frequency coordinates. -/
noncomputable def blockFourierSynthesis :
    (ZMod L → a → ℂ) →ₗ[ℂ] (a × ZMod L → ℂ) where
  toFun c i := ∑ j : ZMod L, c j i.1 * fourierBasisVector j i.2
  map_add' x y := by
    funext i
    simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
  map_smul' z x := by
    funext i
    simp only [Pi.smul_apply, RingHom.id_apply, smul_eq_mul]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    ring

omit [Fintype a] in
/-- The simultaneous frequency splitting is complete, not merely injective. -/
lemma blockFourierSynthesis_bijective :
    Function.Bijective (blockFourierSynthesis (L := L) (a := a)) := by
  constructor
  · intro x y h
    funext j i
    have hi : fourierSynthesis (fun j => x j i) =
        fourierSynthesis (fun j => y j i) := by
      funext r
      exact congrFun h (i, r)
    exact congrFun (fourierSynthesis_bijective.1 hi) j
  · intro v
    choose c hc using fun i : a =>
      fourierSynthesis_bijective.2 (fun r => v (i, r))
    refine ⟨fun j i => c i j, ?_⟩
    funext ir
    rcases ir with ⟨i, r⟩
    exact congrFun (hc i) r

/-- Simultaneous Fourier synthesis exactly conjugates a block-circulant
matrix to the direct sum of its small frequency symbols. -/
theorem blockCirculantMatrix_mulVec_blockFourierSynthesis
    (kernel : a → a → ZMod L → ℂ) (c : ZMod L → a → ℂ) :
    Matrix.mulVec (blockCirculantMatrix kernel) (blockFourierSynthesis c) =
      blockFourierSynthesis
        (fun j => Matrix.mulVec (blockFourierSymbol kernel j) (c j)) := by
  have hsynthesis (d : ZMod L → a → ℂ) :
      blockFourierSynthesis d =
        ∑ j : ZMod L, frequencyEmbed j (d j) := by
    funext i
    simp [blockFourierSynthesis, frequencyEmbed]
  rw [hsynthesis]
  change (blockCirculantMatrix kernel).mulVecLin
      (∑ j : ZMod L, frequencyEmbed j (c j)) = _
  rw [map_sum]
  simp only [Matrix.mulVecLin_apply]
  simp_rw [blockCirculantMatrix_mulVec_frequencyEmbed]
  rw [← hsynthesis]

/-- Eigenvectors of a small symbol lift to eigenvectors of the full matrix. -/
theorem frequencyEmbed_eigenvector
    (kernel : a → a → ZMod L → ℂ)
    (j : ZMod L) (z : a → ℂ) (eigenvalue : ℂ)
    (hz : Matrix.mulVec (blockFourierSymbol kernel j) z = eigenvalue • z) :
    Matrix.mulVec (blockCirculantMatrix kernel) (frequencyEmbed j z) =
      eigenvalue • frequencyEmbed j z := by
  rw [blockCirculantMatrix_mulVec_frequencyEmbed, hz]
  funext i
  simp [frequencyEmbed, mul_assoc]

end Blocks

/-! ## Equality-word symbols are Fourier Gram matrices -/

/-- Complex cyclic cross-correlation. -/
noncomputable def complexCrossCorrelation
    (left right : ZMod L → ℂ) (shift : ZMod L) : ℂ :=
  ∑ t : ZMod L, left (t + shift) * right t

/-- The positive transform of cyclic cross-correlation factors into the
positive transform of the left word and the negative transform of the right
word. -/
theorem dft_complexCrossCorrelation_neg
    (left right : ZMod L → ℂ) (j : ZMod L) :
    ZMod.dft (complexCrossCorrelation left right) (-j) =
      (∑ x : ZMod L, stdAddChar (x * j) * left x) *
        (∑ t : ZMod L, stdAddChar (-(t * j)) * right t) := by
  simp only [ZMod.dft_apply, mul_neg, neg_neg, complexCrossCorrelation]
  calc
    ∑ u : ZMod L, stdAddChar (u * j) •
        ∑ t : ZMod L, left (t + u) * right t =
        ∑ t : ZMod L, ∑ u : ZMod L,
          stdAddChar (u * j) * (left (t + u) * right t) := by
      simp only [smul_eq_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
    _ = ∑ t : ZMod L, ∑ x : ZMod L,
          stdAddChar ((x - t) * j) * (left x * right t) := by
      apply Finset.sum_congr rfl
      intro t _
      apply Fintype.sum_equiv (Equiv.addLeft t)
      intro u
      change stdAddChar (u * j) * (left (t + u) * right t) =
        stdAddChar (((t + u) - t) * j) *
          (left (t + u) * right t)
      simp [add_sub_cancel_left]
    _ = ∑ t : ZMod L, ∑ x : ZMod L,
          (stdAddChar (x * j) * left x) *
            (stdAddChar (-(t * j)) * right t) := by
      apply Finset.sum_congr rfl
      intro t _
      apply Finset.sum_congr rfl
      intro x _
      rw [show (x - t) * j = x * j + -(t * j) by ring,
        AddChar.map_add_eq_mul]
      ring
    _ = (∑ x : ZMod L, stdAddChar (x * j) * left x) *
        (∑ t : ZMod L, stdAddChar (-(t * j)) * right t) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro t _
      rw [Finset.sum_mul]

section Words

variable {a κ : Type*} [Fintype a] [Fintype κ] [DecidableEq κ]

/-- One-hot digit coordinate of a cyclic word family. -/
def wordIndicator (word : a → ZMod L → κ)
    (i : a) (d : κ) (t : ZMod L) : ℂ :=
  if word i t = d then 1 else 0

/-- Negative-sign Fourier coefficient of one digit coordinate. -/
noncomputable def wordFourierCoefficient
    (word : a → ZMod L → κ) (i : a) (d : κ) (j : ZMod L) : ℂ :=
  ∑ t : ZMod L, stdAddChar (-(t * j)) * wordIndicator word i d t

omit [Fintype a] in
/-- Summing every digit coordinate recovers the Fourier transform of the
constant-one word. -/
theorem sum_wordFourierCoefficient
    (word : a → ZMod L → κ) (i : a) (j : ZMod L) :
    ∑ d, wordFourierCoefficient word i d j =
      ∑ t : ZMod L, stdAddChar (-(t * j)) := by
  simp only [wordFourierCoefficient]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro t ht
  rw [← Finset.mul_sum]
  simp [wordIndicator]

omit [Fintype a] in
/-- At every nonzero frequency, the digit-coordinate Fourier coefficients
sum to zero.  This is the exact partition-of-unity rank-loss input. -/
theorem sum_wordFourierCoefficient_eq_zero
    (word : a → ZMod L → κ) (i : a) {j : ZMod L} (hj : j ≠ 0) :
    ∑ d, wordFourierCoefficient word i d j = 0 := by
  rw [sum_wordFourierCoefficient]
  have hneg : -j ≠ 0 := neg_ne_zero.mpr hj
  have hsum : ∑ t : ZMod L, stdAddChar ((-j) * t) = 0 :=
    AddChar.sum_eq_zero_of_ne_one (isPrimitive_stdAddChar L hneg)
  convert hsum using 1
  apply Finset.sum_congr rfl
  intro t ht
  congr 1
  ring

omit [Fintype a] [Fintype κ] in
/-- Cyclically shifting one word multiplies its Fourier coefficient by the
corresponding unit phase.  This is the exact representative-change law. -/
theorem wordFourierCoefficient_shift
    (word : a → ZMod L → κ) (q : a → ZMod L)
    (i : a) (d : κ) (j : ZMod L) :
    wordFourierCoefficient (fun i t => word i (t + q i)) i d j =
      stdAddChar (q i * j) * wordFourierCoefficient word i d j := by
  unfold wordFourierCoefficient wordIndicator
  rw [Finset.mul_sum]
  apply Fintype.sum_equiv (Equiv.addRight (q i))
  intro t
  dsimp only
  change stdAddChar (-(t * j)) *
      (if word i (t + q i) = d then 1 else 0) =
    stdAddChar (q i * j) *
      (stdAddChar (-((t + q i) * j)) *
        (if word i (t + q i) = d then 1 else 0))
  rw [show -(t * j) = q i * j + -((t + q i) * j) by ring,
    AddChar.map_add_eq_mul]
  ring_nf

/-- The normalized equality-correlation kernel of two cyclic words. -/
noncomputable def wordCorrelationKernel
    (word : a → ZMod L → κ) (i k : a) (shift : ZMod L) : ℂ :=
  (L : ℂ)⁻¹ *
    ∑ t : ZMod L, if word i (t + shift) = word k t then 1 else 0

omit [NeZero L] [Fintype a] in
/-- Summing one-hot coordinate products gives the equality indicator. -/
lemma sum_wordIndicator_mul_wordIndicator
    (word : a → ZMod L → κ) (i k : a) (x t : ZMod L) :
    (∑ d : κ, wordIndicator word i d x * wordIndicator word k d t) =
      if word i x = word k t then 1 else 0 := by
  by_cases h : word i x = word k t
  · rw [if_pos h]
    simp only [wordIndicator]
    rw [← h]
    simp
  · rw [if_neg h]
    apply Finset.sum_eq_zero
    intro d _
    by_cases hi : word i x = d
    · have hk : word k t ≠ d := by
        intro hk
        exact h (hi.trans hk.symm)
      simp [wordIndicator, hi, hk]
    · simp [wordIndicator, hi]

omit [Fintype a] [Fintype κ] in
/-- The positive word transform is the complex conjugate of the declared
negative-sign coefficient. -/
lemma sum_positive_wordIndicator_eq_star_wordFourierCoefficient
    (word : a → ZMod L → κ) (i : a) (d : κ) (j : ZMod L) :
    (∑ t : ZMod L, stdAddChar (t * j) * wordIndicator word i d t) =
      starRingEnd ℂ (wordFourierCoefficient word i d j) := by
  rw [wordFourierCoefficient, map_sum]
  apply Finset.sum_congr rfl
  intro t _
  rw [map_mul (starRingEnd ℂ)]
  have hchar : starRingEnd ℂ (stdAddChar (-(t * j))) =
      stdAddChar (t * j) := by
    simpa only [starRingEnd_apply, neg_neg] using
      (AddChar.map_neg_eq_conj (stdAddChar (N := L)) (-(t * j))).symm
  rw [hchar]
  congr 1
  simp [wordIndicator]

omit [Fintype a] [Fintype κ] in
/-- Opposite orbit frequencies have conjugate word coefficients. -/
theorem wordFourierCoefficient_neg
    (word : a → ZMod L → κ) (i : a) (d : κ) (j : ZMod L) :
    wordFourierCoefficient word i d (-j) =
      starRingEnd ℂ (wordFourierCoefficient word i d j) := by
  rw [← sum_positive_wordIndicator_eq_star_wordFourierCoefficient]
  unfold wordFourierCoefficient
  apply Finset.sum_congr rfl
  intro t _
  congr 1
  ring_nf

omit [Fintype a] in
/-- The complete transform of each equality-correlation block is exactly the
small Hermitian Gram entry printed in the manuscript. -/
lemma wordCorrelationKernel_symbol_eq_frequencyGram
    (word : a → ZMod L → κ) (i k : a) (j : ZMod L) :
    ZMod.dft (wordCorrelationKernel word i k) (-j) =
      (L : ℂ)⁻¹ * ∑ d : κ,
        starRingEnd ℂ (wordFourierCoefficient word i d j) *
          wordFourierCoefficient word k d j := by
  have hkernel : wordCorrelationKernel word i k =
      (L : ℂ)⁻¹ •
        (∑ d : κ, complexCrossCorrelation
          (wordIndicator word i d) (wordIndicator word k d)) := by
    funext shift
    unfold wordCorrelationKernel complexCrossCorrelation
    simp only [Pi.smul_apply, smul_eq_mul, Finset.sum_apply]
    change (L : ℂ)⁻¹ *
        (∑ t : ZMod L, if word i (t + shift) = word k t then 1 else 0) =
      (L : ℂ)⁻¹ *
        (∑ d : κ, ∑ t : ZMod L,
          wordIndicator word i d (t + shift) * wordIndicator word k d t)
    congr 1
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro t _
    rw [sum_wordIndicator_mul_wordIndicator]
  rw [hkernel, LinearMapClass.map_smul, map_sum]
  simp only [Pi.smul_apply, smul_eq_mul, Finset.sum_apply]
  congr 1
  apply Finset.sum_congr rfl
  intro d _
  rw [dft_complexCrossCorrelation_neg,
    sum_positive_wordIndicator_eq_star_wordFourierCoefficient]
  rfl

omit [Fintype a] in
/-- Entrywise identification of every small Fourier symbol with the declared
frequency Gram matrix. -/
lemma blockFourierSymbol_wordCorrelationKernel
    (word : a → ZMod L → κ) (j : ZMod L) :
    blockFourierSymbol (wordCorrelationKernel word) j =
      fun i k => (L : ℂ)⁻¹ * ∑ d : κ,
        starRingEnd ℂ (wordFourierCoefficient word i d j) *
          wordFourierCoefficient word k d j := by
  ext i k
  exact wordCorrelationKernel_symbol_eq_frequencyGram word i k j

end Words

end NField.Alignment.CosetFourierReduction
