import NField.Alignment.UnityNativeHilbert

/-!
# Native residuals, positive deficits and exact projection gains

All subspaces here are generated by the actual fractional clocks in the
reciprocal-weight Hilbert model. Mathlib supplies their orthogonal projections.
-/
noncomputable section
set_option autoImplicit false
namespace NField.Alignment.UnityNativeProjection
open scoped BigOperators
open UnityNativeHilbert

/-- Evaluation at a native positive integer is linear. -/
def evaluation (m : ℕ) : NativeHilbert →ₗ[ℝ] ℝ where
  toFun f := value f m
  map_add' f g := value_add f g m
  map_smul' c f := by simpa using value_smul c f m

/-- Every clock vanishes at a common positive multiple. -/
theorem clock_factorial_zero {j N : ℕ} (hj : 2 ≤ j) (hjN : j ≤ N) :
    value (clock j) N.factorial = 0 := by
  rw [clock_value _ (Nat.factorial_pos _)]
  obtain ⟨k, hk⟩ := Nat.dvd_factorial (by omega : 0<j) hjN
  have hj0 : (j : ℝ) ≠ 0 := by exact_mod_cast (by omega : j≠0)
  simp [clockValue, hk, Nat.cast_mul, mul_div_cancel_left₀, hj0]

theorem clockSpace_factorial_zero (N : ℕ) {f : NativeHilbert} (hf : f∈clockSpace N) :
    value f N.factorial = 0 := by
  have hle : clockSpace N ≤ (evaluation N.factorial).ker := by
    apply Submodule.span_le.mpr
    rintro _ ⟨j, hj, rfl⟩
    simp only [Finset.mem_coe, Finset.mem_Icc] at hj
    exact clock_factorial_zero hj.1 hj.2
  exact hle hf

/-- Title: `Finite clocks cannot reproduce unity`. -/
theorem unity_not_mem_clockSpace (N : ℕ) : unity ∉ clockSpace N := by
  intro h
  have he := clockSpace_factorial_zero N h
  rw [unity_value (Nat.factorial_pos _)] at he
  norm_num at he

theorem fittedUnity_mem (N : ℕ) : fittedUnity N ∈ clockSpace N :=
  (clockSpace N).starProjection_apply_mem unity

theorem residual_inner_zero (N : ℕ) {f : NativeHilbert} (hf : f∈clockSpace N) :
    inner ℝ (residual N) f = 0 :=
  Submodule.starProjection_inner_eq_zero unity f hf

theorem residual_ne_zero (N : ℕ) : residual N ≠ 0 := by
  intro he
  have h : unity = fittedUnity N := sub_eq_zero.mp he
  exact unity_not_mem_clockSpace N (h ▸ fittedUnity_mem N)

/-- Title: `Every finite native deficit is strictly positive`. -/
theorem deficit_pos (N : ℕ) : 0 < deficit N :=
  sq_pos_of_pos (norm_pos_iff.mpr (residual_ne_zero N))

/-- Title: `Residual energy equals its signed unity reading`. -/
theorem residual_inner_unity (N : ℕ) : inner ℝ (residual N) unity = deficit N := by
  have h := residual_inner_zero N (fittedUnity_mem N)
  have hs : inner ℝ (residual N) (residual N) =
      inner ℝ (residual N) unity - inner ℝ (residual N) (fittedUnity N) := by
    nth_rw 2 [UnityNativeHilbert.residual]
    exact inner_sub_right _ _ _
  rw [real_inner_self_eq_norm_sq, h, sub_zero] at hs
  exact hs.symm

/-- Title: `Fitted and residual energies exhaust unity`.

 Fitted and residual energies exhaust the actual unit mass. -/
theorem fitted_energy (N : ℕ) : ‖fittedUnity N‖^2 + deficit N = 1 := by
  have h := Submodule.norm_sq_eq_add_norm_sq_starProjection unity (clockSpace N)
  rw [Submodule.starProjection_orthogonal_val, unity_norm_sq] at h
  exact h.symm

theorem deficit_le_one (N : ℕ) : deficit N ≤ 1 := by
  have h := fitted_energy N
  nlinarith [sq_nonneg ‖fittedUnity N‖]

/-- The old projection of the new fit is the old fit. -/
theorem nested_fit_projection {N M : ℕ} (hNM : N≤M) :
    projection N (fittedUnity M) = fittedUnity N := by
  have he := congrArg (fun F : NativeHilbert →L[ℝ] NativeHilbert => F unity)
    (Submodule.starProjection_comp_starProjection_of_le (clockSpace_mono hNM))
  exact he

theorem nested_gain_mem {N M : ℕ} (hNM : N≤M) :
    fittedUnity M-fittedUnity N ∈ clockSpace M :=
  (clockSpace M).sub_mem (fittedUnity_mem M) (clockSpace_mono hNM (fittedUnity_mem N))

theorem nested_gain_orthogonal {N M : ℕ} (hNM : N≤M) :
    fittedUnity M-fittedUnity N ∈ (clockSpace N)ᗮ := by
  rw [← nested_fit_projection hNM]
  exact Submodule.sub_starProjection_mem_orthogonal _

/-- Title: `Adding clocks gives the exact projection gain`.

 The paper's exact native gain identity, for its actual optimizer. -/
theorem deficit_difference {N M : ℕ} (hNM : N≤M) :
    deficit N - deficit M = ‖fittedUnity M-fittedUnity N‖^2 := by
  have ho := residual_inner_zero M (nested_gain_mem hNM)
  have hp := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero
    (residual M) (fittedUnity M-fittedUnity N) ho
  have he : residual M + (fittedUnity M-fittedUnity N) = residual N := by
    unfold UnityNativeHilbert.residual
    abel
  rw [he] at hp
  simp only [← sq] at hp
  unfold deficit
  linarith

/-- Title: `Native deficit decreases as clocks are added`. -/
theorem deficit_antitone : Antitone deficit := by
  intro N M hNM
  have h := deficit_difference hNM
  nlinarith [sq_nonneg ‖fittedUnity M-fittedUnity N‖]

/-- Native capacity is the reciprocal of the strictly positive native deficit. -/
def capacity (N : ℕ) : ℝ := (deficit N)⁻¹

/-- Title: `Exact change in native capacity`. -/
theorem capacity_difference (N M : ℕ) :
    capacity M-capacity N = (deficit N-deficit M)/(deficit N*deficit M) := by
  have hN := (deficit_pos N).ne'
  have hM := (deficit_pos M).ne'
  unfold capacity
  field_simp

theorem capacity_monotone : Monotone capacity := by
  intro N M h
  exact inv_anti₀ (deficit_pos M) (deficit_antitone h)

/-- Title: `The native optimizer minimizes the residual energy`.

 The native optimizer minimizes against every actual admitted clock vector. -/
theorem deficit_le_candidate (M : ℕ) {f : NativeHilbert} (hf : f∈clockSpace M) :
    deficit M ≤ ‖unity-f‖^2 := by
  have ho := residual_inner_zero M ((clockSpace M).sub_mem (fittedUnity_mem M) hf)
  have hp := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero
    (residual M) (fittedUnity M-f) ho
  have he : residual M + (fittedUnity M-f) = unity-f := by
    unfold UnityNativeHilbert.residual
    abel
  rw [he] at hp
  simp only [← sq] at hp
  unfold deficit
  nlinarith [sq_nonneg ‖fittedUnity M-f‖]

/-- Gain from any complete admitted probe space. The later finite Gram theorem
identifies this actual projection norm with the Moore--Penrose quadratic form. -/
theorem admitted_projection_gain {N M : ℕ} (hNM : N≤M)
    (W : Submodule ℝ NativeHilbert) [W.HasOrthogonalProjection]
    (hW : W ≤ clockSpace M) :
    ‖W.starProjection (residual N)‖^2 ≤ deficit N-deficit M := by
  let v := W.starProjection (residual N)
  have hv : v∈clockSpace M := hW (W.starProjection_apply_mem _)
  have hc := deficit_le_candidate M
    ((clockSpace M).add_mem (clockSpace_mono hNM (fittedUnity_mem N)) hv)
  have hp := Submodule.norm_sq_eq_add_norm_sq_starProjection (residual N) W
  rw [Submodule.starProjection_orthogonal_val] at hp
  have he : unity-(fittedUnity N+v) = residual N-v := by
    unfold UnityNativeHilbert.residual
    abel
  rw [he] at hc
  change ‖residual N‖^2 = ‖v‖^2+‖residual N-v‖^2 at hp
  unfold deficit at hc ⊢
  dsimp [v] at hp
  linarith

end NField.Alignment.UnityNativeProjection
