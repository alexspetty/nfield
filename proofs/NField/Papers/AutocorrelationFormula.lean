import NField.Alignment.AutocorrelationClosure

/-!
# The Autocorrelation Formula

Reader-facing theorem map for *The Autocorrelation Formula*.
The declarations follow the mathematical objects in the manuscript; the
underlying reusable proof modules remain independent of publication order.

## Checked here

* The intrinsic floor-digit bins, their cumulative starting points, and every
  ordered-interval Fourier phase are exact.
* The same-bin kernel and cross-spectrum are exact two-dimensional Fourier
  transforms, with explicit inversion, antidiagonal power, complement
  reflection, reality, symmetry, and vanishing total.
* Every unit multiplier selects the exact line `k' = -aInv * k`; identity and
  inverse multipliers have the stated collision values.
* A primitive-root certificate constructs the canonical power enumeration of
  all nonzero residues and gives the repetend autocorrelation slice directly.
* Actual cosets of the subgroup generated by the base have the stated
  exponential sums and individual-orbit readout.  At full order the nonzero
  field sum has its two exact values and the double sum collapses to one line.
* Cyclic harmonic energies are Fourier coordinate norm squares and are
  nonnegative.
* The decimal prime-seven cross-spectrum and all six autocorrelation lags are
  exact kernel-checked certificates.
-/

namespace NField.Papers.AutocorrelationFormula

open scoped BigOperators
open ZMod
open NField.Alignment
open NField.Alignment.SpectralPower
open NField.Alignment.AutocorrelationFormula
open NField.CollisionDefinition

local instance paperPrimeBasePeriodNeZero {b p : ℕ}
    (hp : Nat.Prime p) (hpb : ¬p ∣ b) :
    NeZero (primeBasePeriod b p hp hpb) :=
  ⟨(primeBasePeriod_pos hp hpb).ne'⟩

noncomputable local instance paperGeneratedOrbitSubgroupFintype {b p : ℕ}
    (hp : Nat.Prime p) (hpb : ¬p ∣ b) :
    Fintype (primeBaseOrbitSubgroup b p hp hpb) :=
  Fintype.ofFinite _

/-- The coordinate sum is exactly the same-active-label relation. -/
theorem same_bin_relation {N κ : ℕ} [NeZero N]
    (word : ZMod N → Option (Fin κ)) (r s : ZMod N) :
    sameBinKernel word r s =
      if word r = word s ∧ word r ≠ none then 1 else 0 :=
  sameBinKernel_eq_indicator word r s

/-- Complement reflection holds for the floor digit and for the complete
same-bin kernel. -/
theorem prime_complement_reflection {b p : ℕ}
    (hb : 0 < b) (hp : Nat.Prime p) (hpb : ¬p ∣ b) [NeZero p]
    (r : ZMod p) (hr : r ≠ 0) (s : ZMod p) :
    digitBin b p (-r).val = b - 1 - digitBin b p r.val ∧
      sameBinKernel (primeDigitWord b p hb hp.pos) (-r) (-s) =
        sameBinKernel (primeDigitWord b p hb hp.pos) r s :=
  ⟨primeDigitWord_digit_neg hb hp hpb r hr,
    primeDigitWord_kernel_neg hb hp hpb r s⟩

/-- The cross-spectrum is the exact two-dimensional transform of the
same-bin kernel. -/
theorem two_dimensional_transform {N κ : ℕ} [NeZero N]
    (word : ZMod N → Option (Fin κ)) (k k' : ZMod N) :
    crossSpectrum word k k' =
      ∑ r : ZMod N, ∑ s : ZMod N,
        sameBinKernel word r s *
          stdAddChar (-(r * k) - (s * k')) :=
  crossSpectrum_eq_kernel_transform word k k'

/-- Pointwise two-dimensional inversion with both normalization factors
visible. -/
theorem explicit_kernel_inversion {N κ : ℕ} [NeZero N]
    (word : ZMod N → Option (Fin κ)) (r s : ZMod N) :
    sameBinKernel word r s =
      (N : ℂ)⁻¹ * ∑ k' : ZMod N, stdAddChar (k' * s) *
        ((N : ℂ)⁻¹ * ∑ k : ZMod N,
          stdAddChar (k * r) * crossSpectrum word k k') :=
  sameBinKernel_eq_inverse_sum word r s

/-- Spectral power is exactly the antidiagonal of the cross-spectrum. -/
theorem spectral_power_antidiagonal {N κ : ℕ} [NeZero N]
    (word : ZMod N → Option (Fin κ)) (k : ZMod N) :
    crossSpectrum word k (-k) = spectralPower word k :=
  crossSpectrum_antidiagonal word k

/-- Complement reflection gives the complete real, symmetric, and
simultaneous-negation invariance statement. -/
theorem prime_reality_and_symmetry {b p : ℕ}
    (hb : 0 < b) (hp : Nat.Prime p) (hpb : ¬p ∣ b) [NeZero p]
    (k k' : ZMod p) :
    starRingEnd ℂ
        (crossSpectrum (primeDigitWord b p hb hp.pos) k k') =
          crossSpectrum (primeDigitWord b p hb hp.pos) k k' ∧
      crossSpectrum (primeDigitWord b p hb hp.pos) k k' =
        crossSpectrum (primeDigitWord b p hb hp.pos) k' k ∧
      crossSpectrum (primeDigitWord b p hb hp.pos) (-k) (-k') =
        crossSpectrum (primeDigitWord b p hb hp.pos) k k' := by
  exact ⟨(prime_crossSpectrum_real_symmetric hb hp hpb k k').1,
    (prime_crossSpectrum_real_symmetric hb hp hpb k k').2,
    crossSpectrum_neg_of_kernel_neg _
      (primeDigitWord_kernel_neg hb hp hpb) k k'⟩

/-- Omitting residue zero forces the complete transform total to vanish. -/
theorem vanishing_transform_total {b p : ℕ}
    (hb : 0 < b) (hp : Nat.Prime p) [NeZero p] :
    (∑ k : ZMod p, ∑ k' : ZMod p,
      crossSpectrum (primeDigitWord b p hb hp.pos) k k') = 0 :=
  crossSpectrum_total_eq_zero _ (primeDigitWord_zero b p hb hp.pos)

/-- Exact cumulative starts, individual interval coefficients, and the
ordered-bin expression for every cross-spectrum entry. -/
theorem ordered_bin_interval_formula {b p : ℕ}
    (hb : 0 < b) (hp : Nat.Prime p) [NeZero p]
    (d : Fin b) (k k' : ZMod p) :
    orderedBinStart b p d.val =
        1 + ∑ e ∈ Finset.range d.val, digitBinPopulation b p e ∧
      binFourier (primeDigitWord b p hb hp.pos) d k =
        stdAddChar (-((orderedBinStart b p d.val : ZMod p) * k)) *
          intervalFourier p (orderedBinLength b p d.val) k ∧
      crossSpectrum (primeDigitWord b p hb hp.pos) k k' =
        ∑ e : Fin b,
          stdAddChar
              (-((orderedBinStart b p e.val : ZMod p) * (k + k'))) *
            intervalFourier p (orderedBinLength b p e.val) k *
            intervalFourier p (orderedBinLength b p e.val) k' := by
  exact ⟨orderedBinStart_eq_one_add_prefix hb hp.pos d,
    prime_binFourier_eq_ordered_interval hb hp.pos d k,
    prime_crossSpectrum_eq_ordered_intervals hb hp.pos k k'⟩

/-- Exact multiplicative line-slice formula for every explicit unit
multiplier and inverse. -/
theorem multiplicative_line_slice {N κ : ℕ} [NeZero N]
    (word : ZMod N → Option (Fin κ)) (a aInv : ZMod N)
    (hinv : a * aInv = 1) :
    multiplicativeCollision word a =
      (N : ℂ)⁻¹ * ∑ k : ZMod N,
        crossSpectrum word k (-aInv * k) :=
  multiplicative_slice word a aInv hinv

/-- The identity multiplier gives all `p-1` nonzero matches, and inverse
multipliers have equal collision counts. -/
theorem identity_and_inverse_collision {b p : ℕ}
    (hb : 0 < b) (hp : Nat.Prime p) [NeZero p]
    (a aInv : ZMod p) (hinv : a * aInv = 1) :
    multiplicativeCollision (primeDigitWord b p hb hp.pos) 1 =
        ((p - 1 : ℕ) : ℂ) ∧
      multiplicativeCollision (primeDigitWord b p hb hp.pos) aInv =
        multiplicativeCollision (primeDigitWord b p hb hp.pos) a :=
  ⟨prime_multiplicativeCollision_one hb hp,
    multiplicativeCollision_inverse _ a aInv hinv⟩

/-- A primitive-root certificate gives full order and a bijective canonical
power enumeration of every unit residue. -/
theorem canonical_primitive_power_equivalence {b p : ℕ}
    (hp : Nat.Prime p) (hpb : ¬p ∣ b)
    (hprimitive : IsPrimitiveRoot (primeBaseUnit b p hp hpb) (p - 1)) :
    primeBasePeriod b p hp hpb = p - 1 ∧
      Function.Bijective (canonicalPrimePowerMap hp hpb) := by
  let hfull := primeBasePeriod_eq_full_of_isPrimitiveRoot hp hpb hprimitive
  exact ⟨hfull,
    canonicalPrimePowerMap_bijective_of_full_order hp hpb hfull⟩

/-- The primitive-root repetend autocorrelation has the manuscript's exact
line slice with its orbit and motion law constructed canonically. -/
theorem canonical_repetend_autocorrelation_slice {b p κ : ℕ}
    (hp : Nat.Prime p) (hpb : ¬p ∣ b) [NeZero p]
    (hprimitive : IsPrimitiveRoot (primeBaseUnit b p hp hpb) (p - 1))
    (word : ZMod p → Option (Fin κ)) (hzero : word 0 = none)
    (lag : ZMod (primeBasePeriod b p hp hpb)) :
    let hfull := primeBasePeriod_eq_full_of_isPrimitiveRoot hp hpb hprimitive
    let a : (ZMod p)ˣ := (primeBaseUnit b p hp hpb) ^ lag.val
    fullOrbitAutocorrelation word (canonicalPrimeOrbitEquiv hp hpb hfull) lag =
      (p : ℂ)⁻¹ * ∑ k : ZMod p,
        crossSpectrum word k (-((a⁻¹ : (ZMod p)ˣ) : ZMod p) * k) :=
  canonical_primitiveRoot_autocorrelation_slice hp hpb hprimitive word hzero lag

/-- The Fourier transform of cyclic digit autocorrelation is the exact
coordinate power sum. -/
theorem harmonic_autocorrelation_transform {L κ : ℕ} [NeZero L]
    (word : ZMod L → Option (Fin κ)) (j : ZMod L) :
    𝓕 (fun lag => (cyclicDigitAutocorrelation word lag : ℂ)) j =
      spectralPower word j :=
  cyclic_autocorrelation_transform word j

/-- Every normalized cyclic harmonic energy is real and nonnegative. -/
theorem harmonic_energy_nonnegative {L κ : ℕ} [NeZero L]
    (word : ZMod L → Option (Fin κ)) (j : ZMod L) :
    0 ≤ (((L : ℂ)⁻¹ *
      𝓕 (fun lag => (cyclicDigitAutocorrelation word lag : ℂ)) j).re) :=
  cyclic_harmonic_energy_nonnegative word j

/-- Exact aggregate decomposition for any finite orbit labeling. -/
theorem aggregate_orbit_readout {N κ : ℕ} [NeZero N]
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (word : ZMod N → Option (Fin κ)) (orbitOf : ZMod N → ι)
    (a : ZMod N) :
    multiplicativeCollision word a =
      ∑ c : ι, subsetCollision word
        (Finset.univ.filter fun r => orbitOf r = c) a :=
  collision_aggregation word orbitOf a

/-- The additive weight of an actual coset `c <b>` is its generated-subgroup
exponential sum. -/
theorem generated_coset_exponential_sum {b p : ℕ}
    (hp : Nat.Prime p) (hpb : ¬p ∣ b) [NeZero p]
    (c : (ZMod p)ˣ) (m : ZMod p) :
    subsetExponential (generatedOrbitCosetSet hp hpb c) m =
      ∑ u : primeBaseOrbitSubgroup b p hp hpb,
        stdAddChar (m * (((c * u.val : (ZMod p)ˣ) : ZMod p))) :=
  generatedOrbitCoset_exponential hp hpb c m

/-- The individual-orbit double sum for an actual coset of the subgroup
generated by the base. -/
theorem individual_generated_coset_readout {b p κ : ℕ}
    (hp : Nat.Prime p) (hpb : ¬p ∣ b) [NeZero p]
    (word : ZMod p → Option (Fin κ)) (c : (ZMod p)ˣ) (a : ZMod p) :
    subsetCollision word (generatedOrbitCosetSet hp hpb c) a =
      ((p : ℂ)⁻¹) ^ 2 * ∑ k : ZMod p, ∑ k' : ZMod p,
        crossSpectrum word k k' *
          subsetExponential (generatedOrbitCosetSet hp hpb c) (k + a * k') :=
  generatedOrbitCoset_collision_formula hp hpb word c a

/-- The complete nonzero-field exponential sum has exactly its two stated
values. -/
theorem full_group_exponential_sum {N : ℕ} [NeZero N] (m : ZMod N) :
    subsetExponential (fullNonzeroResidueSet N) m =
      if m = 0 then ((N - 1 : ℕ) : ℂ) else (-1 : ℂ) :=
  fullNonzeroResidue_exponential m

/-- On the complete nonzero field, the individual-orbit double sum collapses
exactly to the multiplicative line slice. -/
theorem full_group_collapse_to_slice {N κ : ℕ} [NeZero N]
    (word : ZMod N → Option (Fin κ)) (a aInv : ZMod N)
    (hzero : word 0 = none) (hinv : a * aInv = 1) :
    ((N : ℂ)⁻¹) ^ 2 * ∑ k : ZMod N, ∑ k' : ZMod N,
        crossSpectrum word k k' *
          subsetExponential (fullNonzeroResidueSet N) (k + a * k') =
      (N : ℂ)⁻¹ * ∑ k : ZMod N,
        crossSpectrum word k (-aInv * k) :=
  fullNonzero_orbit_formula_collapses_to_slice word a aInv hzero hinv

/-- The decimal prime-seven cross-spectrum is six on the antidiagonal and
minus one elsewhere. -/
theorem decimal_seven_cross_spectrum (k k' : ZMod 7) :
    crossSpectrum
        (primeDigitWord 10 7 (by norm_num) (by norm_num)) k k' =
      if k + k' = 0 then (6 : ℂ) else (-1 : ℂ) :=
  decimalSevenCrossSpectrum_certificate k k'

/-- The word `142857` agrees at all six positions only at zero lag and at no
position at every nonzero cyclic lag. -/
theorem decimal_seven_autocorrelation :
    ∀ lag : Fin 6,
      NField.Alignment.CrossAlignmentMatrix.crossCorrelation
          decimalSevenWord decimalSevenWord lag =
        if lag = 0 then 6 else 0 :=
  decimalSevenAutocorrelation_certificate

